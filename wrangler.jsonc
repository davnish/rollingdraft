// Cloudflare Workers config: a static-assets-only Worker serving Astro's dist/.
// Workers Builds runs `npm run build`, then `npx wrangler deploy`.
// `name` must match the Worker in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rollingdraft",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    // /about serves about/index.html and redirects to /about/.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
