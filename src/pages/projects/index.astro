---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../content';

const projects = await getProjects();
---

<Base title="Projects" description="Side projects and experiments, each running on its own rollingdraft.com subdomain.">
  <section class="page-head wrap-wide">
    <h1>Projects</h1>
    <p class="lede">Projects I've built or am still building. The ones currently deployed are marked with a green <em>live</em> tag.</p>
  </section>
  <section class="wrap-wide">
    <ul class="cards">{projects.map((p) => <ProjectCard project={p} />)}</ul>
  </section>
</Base>
