---
import Base from '../layouts/Base.astro';
import GitHub from '../components/icons/GitHub.astro';
import LinkedIn from '../components/icons/LinkedIn.astro';
---

<Base title="About" description="About Nischal Singh and rollingdraft.">
  <article class="prose wrap">
    <header class="about-head">
      <img class="avatar" src="/me.jpg" alt="Nischal Singh" width="96" height="96" />
      <div>
        <h1>About</h1>
        <p class="lede">Hi, I'm Nischal.</p>
      </div>
    </header>

    <p>
      I work on ML, geospatial data, AI and the infrastructure behind them. rollingdraft is where
      my projects live: small things I build to learn, and notes on what I find.
    </p>

    <div class="hero-actions">
      <a class="btn btn-secondary" href="https://github.com/davnish"><GitHub /> GitHub</a>
      <a class="btn btn-secondary" href="https://www.linkedin.com/in/nischal-singh/"><LinkedIn /> LinkedIn</a>
    </div>
  </article>
</Base>
