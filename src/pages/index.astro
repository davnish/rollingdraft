---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { getPosts, getProjects } from '../content';

const projects = (await getProjects()).slice(0, 4);
const posts = (await getPosts()).slice(0, 5);
---

<Base>
  <section class="hero wrap-wide">
    <span class="eyebrow">Side projects &amp; experiments</span>
    <h1>Things I build to find out<br class="br-wide" /> how they work.</h1>
    <p class="lede">
      rollingdraft is where my side projects live: small, working experiments that I keep
      improving, and notes on what I learned building them.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/sidequests/">Explore sidequests</a>
      <a class="btn btn-secondary" href="/blog/">Read the blog</a>
    </div>
  </section>

  <section class="section wrap-wide">
    <div class="section-head">
      <h2>Sidequests</h2>
      <a href="/sidequests/">All projects →</a>
    </div>
    <ul class="cards">{projects.map((p) => <ProjectCard project={p} />)}</ul>
  </section>

  <section class="section wrap-wide">
    <div class="section-head">
      <h2>Latest writing</h2>
      <a href="/blog/">All posts →</a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>
