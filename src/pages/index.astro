---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { getPosts, getProjects } from '../content';

const allProjects = await getProjects();
const projects = allProjects.slice(0, 4);
const posts = (await getPosts()).slice(0, 5);
// The notice above the headline names the newest live project.
const latestLive = allProjects
  .filter((p) => p.data.status === 'live' && p.data.url)
  .sort((a, b) => b.data.started.valueOf() - a.data.started.valueOf())[0];
const liveHost = latestLive?.data.url ? new URL(latestLive.data.url).host : undefined;
---

<Base>
  <section class="hero wrap-wide">
    {latestLive && (
      <a class="notice" href={latestLive.data.url}>
        <span class="status status-live">live</span>
        <span><strong>{latestLive.data.title}</strong> at {liveHost}</span>
        <ArrowIcon />
      </a>
    )}
    <h1>Drafts from my running logs.</h1>
    <p class="lede">
      Hi, welcome to my quests. I build, deploy and try to write down what I learn along the way.
    </p>
    <p class="hero-note">Some of my projects are live. Click "See the projects" to check them out.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/sidequests/">See the projects</a>
      <a class="btn btn-secondary" href="/blog/">Read the blog</a>
    </div>
  </section>

  <section class="section wrap-wide">
    <div class="section-head">
      <h2>Projects</h2>
      <a class="arrow-link" href="/sidequests/">All projects <ArrowIcon /></a>
    </div>
    <ul class="cards">{projects.map((p) => <ProjectCard project={p} />)}</ul>
  </section>

  <section class="section wrap-wide">
    <div class="section-head">
      <h2>Latest posts</h2>
      <a class="arrow-link" href="/blog/">All posts <ArrowIcon /></a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>
