---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GitHub from '../../components/icons/GitHub.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getProjects, formatDate } from '../../content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, url, repo, status, started, tags } = project.data;
const related = (await getPosts()).filter((p) => p.data.project === project.id);
---

<Base title={title} description={summary}>
  <article class="prose wrap">
    <header>
      <span class={`status status-${status}`}>{status}</span>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <p class="meta">Started {formatDate(started)}</p>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
      {(url || repo) && (
        <div class="hero-actions">
          {url && <a class="btn btn-primary" href={url}>Visit {title} ↗</a>}
          {repo && <a class="btn btn-secondary" href={repo}><GitHub /> GitHub</a>}
        </div>
      )}
    </header>
    <Content />
    {related.length > 0 && (
      <>
        <h2>Posts about {title}</h2>
        <PostList posts={related} />
      </>
    )}
  </article>
</Base>
