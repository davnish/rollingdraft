---
import '../styles/global.css';
import RdMark from '../components/RdMark.astro';
import GitHub from '../components/icons/GitHub.astro';
import LinkedIn from '../components/icons/LinkedIn.astro';
import Rss from '../components/icons/Rss.astro';

interface Props {
  title?: string;
  description?: string;
}

const site = 'rollingdraft';
const { title, description = 'Hi, welcome to my quests. I build, deploy and try to write down what I learn along the way.' } = Astro.props;
const fullTitle = title ? `${title} · ${site}` : site;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/sidequests', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Light by default; dark only when the visitor picked it. Runs before first paint.
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="rollingdraft blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fafafa" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/brand.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap-wide">
        <a class="rd-wordmark" href="/" aria-label="rollingdraft home"><RdMark size={26} /><span>rollingdraft</span></a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a class="nav-link" href={item.href === '/' ? '/' : `${item.href}/`} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <span class="nav-divider" aria-hidden="true"></span>
        <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" data-theme-toggle>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap-wide">
        <span>© {new Date().getFullYear()} Nischal Singh</span>
        <nav aria-label="Elsewhere">
          <a class="icon-link" href="https://github.com/davnish" aria-label="GitHub" title="GitHub"><GitHub /></a>
          <a class="icon-link" href="https://www.linkedin.com/in/nischal-singh/" aria-label="LinkedIn" title="LinkedIn"><LinkedIn /></a>
          <a class="icon-link" href="/rss.xml" aria-label="RSS feed" title="RSS feed"><Rss /></a>
        </nav>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      // A toggle with a fixed name: screen readers announce "Dark mode, pressed" or "not pressed".
      const label = () => {
        button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      };
      label();
      button.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        label();
      });
    </script>
  </body>
</html>
